@page "/admin/retention"
@attribute [Authorize(Policy = "permission:ManageRetention")]
@using Microsoft.EntityFrameworkCore
@using TalkWatch.Data
@inject TalkWatchDbContext Db

<PageTitle>Retention · TalkWatch</PageTitle>

<header class="head">
    <div class="title">
        <h1>Retention</h1>
        <div class="sub">How long calls, recordings and voicemail are kept, and a check that the copied audio is whole.</div>
    </div>
</header>

@if (!string.IsNullOrEmpty(Msg))
{
    <p class="notice" role="status">@Msg</p>
}

<section class="plane" aria-label="Now">
    <div class="plane-body row" style="gap: 14px; align-items: flex-start">
        <span class="dot-ic" style="width: 32px; height: 32px"><Icon Name="@(_settings?.Held == true ? "lock" : "clock")" /></span>
        <div class="stack" style="gap: 4px">
            <p style="margin: 0; font-size: 16px" data-policy="@(_settings?.Preset ?? RetentionPreset.KeepEverything)">
                @if (_settings is null || _settings.Preset == RetentionPreset.KeepEverything)
                {
                    <text>Everything is kept. Nothing is removed until a policy is chosen.</text>
                }
                else if (_settings.Held)
                {
                    <text>A legal hold is on: nothing is removed, whatever the periods say, until it is lifted.</text>
                }
                else
                {
                    <text>Calls are kept for @Describe(_settings.CallDays), recordings and voicemail for @Describe(_settings.AudioDays ?? _settings.CallDays)@(_settings.MinimumDays is { } m ? $", and nothing younger than {m} days is removed" : "").</text>
                }
            </p>
            @if (_settings?.LastSweepAt is { } swept)
            {
                <span class="muted" style="font-size: 12px" data-last-sweep>Last sweep @swept.ToLocalTime().ToString("yyyy-MM-dd HH:mm"): @_settings.LastSweepCalls calls and @_settings.LastSweepFiles audio files removed.</span>
            }
        </div>
    </div>
</section>

<div class="split">
    <section class="plane" aria-label="Policy">
        <div class="plane-head"><h2>Policy</h2><div class="end"><form method="post" action="/admin/retention/sweep"><AntiforgeryToken /><button type="submit" class="btn ghost sm">Sweep now</button></form></div></div>
        <form method="post" action="/admin/retention" class="retention plane-body stack" style="gap: 14px">
            <AntiforgeryToken />
            <div class="choice-list">
                @foreach (var preset in Enum.GetValues<RetentionPreset>())
                {
                    <label class="preset">
                        <input type="radio" name="Preset" value="@preset" checked="@(preset == (_settings?.Preset ?? RetentionPreset.KeepEverything))" />
                        <span class="stack" style="gap: 2px"><strong>@Name(preset)</strong><span class="muted" style="font-size: 12px">@Sentence(Explain(preset))</span></span>
                    </label>
                }
            </div>

            <fieldset class="stack" style="gap: 10px; border: 1px solid var(--line); border-radius: var(--r2); padding: 12px">
                <legend class="eyebrow" style="padding: 0 6px">Custom periods, in days (empty keeps)</legend>
                <div class="row" style="gap: 12px; flex-wrap: wrap">
                    <label class="field"><span class="label">Calls</span><input class="input minutes" name="CallDays" type="number" min="1" value="@(_settings?.Preset == RetentionPreset.Custom ? _settings.CallDays : null)" /></label>
                    <label class="field"><span class="label">Recordings and voicemail</span><input class="input minutes" name="AudioDays" type="number" min="1" value="@(_settings?.Preset == RetentionPreset.Custom ? _settings.AudioDays : null)" /></label>
                    <label class="field"><span class="label">Minimum</span><input class="input minutes" name="MinimumDays" type="number" min="0" value="@(_settings?.Preset == RetentionPreset.Custom ? _settings.MinimumDays : null)" /></label>
                </div>
            </fieldset>
            <div class="row"><button type="submit" class="btn primary sm">Save policy</button></div>
            <p class="hint" style="margin: 0">
                Removing a call removes its events, lines, recordings, voicemail, the console responses that held it, and the alerts raised
                about it. A report copy goes once every call it covers has gone; the report itself stays. The audit log is
                kept. Calls the policy has removed are not copied from the console again.
                These presets are starting points, not legal advice: check what applies to you.
            </p>
        </form>
    </section>

    <section class="plane" aria-label="Audio check">
        <div class="plane-head"><h2>Audio check</h2></div>
        <div class="plane-body stack" style="gap: 12px">
            <p class="hint" style="margin: 0">
                Reads every copied recording and voicemail and checks it against its checksum. Run it after restoring a backup: the
                database and the audio files are backed up minutes apart. Anything missing or damaged is copied again from the console
                at the next poll, while the console still has it. A quick version runs every time TalkWatch starts.
            </p>
            <form method="post" action="/admin/retention/check-audio"><AntiforgeryToken /><button type="submit" class="btn sm">Check audio</button></form>
        </div>
    </section>
</div>

@code {
    [SupplyParameterFromQuery(Name = "msg")] private string? Msg { get; set; }

    private RetentionSettings? _settings;

    protected override async Task OnInitializedAsync() =>
        _settings = await Db.RetentionSettings.AsNoTracking().SingleOrDefaultAsync();

    private static string Sentence(string text) => text.Length == 0 ? text : char.ToUpperInvariant(text[0]) + text[1..];

    private static string Describe(int? days) => days switch
    {
        null => "as long as TalkWatch runs",
        var d when d % 365 is 0 or 1 or 2 && d >= 365 => $"{d / 365} years ({d} days)",
        var d => $"{d} days",
    };

    private static string Name(RetentionPreset preset) => preset switch
    {
        RetentionPreset.KeepEverything => "Keep everything",
        RetentionPreset.UkGdpr => "UK GDPR",
        RetentionPreset.EuGdpr => "EU GDPR",
        RetentionPreset.Fca => "FCA (COBS 11.8)",
        RetentionPreset.LegalHold => "Legal hold",
        _ => "Custom",
    };

    private static string Explain(RetentionPreset preset) => preset switch
    {
        RetentionPreset.KeepEverything => "nothing is removed.",
        RetentionPreset.UkGdpr or RetentionPreset.EuGdpr =>
            "GDPR sets no fixed period, only 'no longer than necessary'. A starting point: audio 1 year, call records 2 years.",
        RetentionPreset.Fca => "recordings kept at least 5 years, and at most 7 (the FCA can ask for up to 7).",
        RetentionPreset.LegalHold => "nothing is removed until the hold is lifted.",
        _ => "the periods below.",
    };
}
