@page "/admin/users"
@* Everyone who can sign in to TalkWatch: their role, whether they can sign in now, two-factor, and which Talk user they
   are on the phone system, if any. Adding someone happens here; the rest on their own page. *@
@attribute [Authorize(Policy = "permission:ManagePeople")]
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using TalkWatch.Data
@using TalkWatch.Web.Services
@inject UserManager<AppUser> Accounts
@inject RoleManager<IdentityRole<Guid>> RoleStore
@inject CurrentSite Site
@inject TalkWatchDbContext Db

<PageTitle>People · TalkWatch</PageTitle>

<header class="head">
    <div class="title">
        <h1>People</h1>
        <div class="sub">@_people.Count @(_people.Count == 1 ? "person signs" : "people sign") in to TalkWatch · @_people.Count(p => p.User.TwoFactorEnabled) with two-factor · @_people.Count(p => p.User.TalkUserUuid is not null) linked to the phone system</div>
    </div>
    <div class="tools">
        <a class="btn ghost sm" href="/admin/roles">Roles</a>
        <a class="btn ghost sm" href="/admin/groups">Group mappings</a>
    </div>
</header>

@if (!string.IsNullOrEmpty(Msg))
{
    <p class="notice" role="status">@Msg</p>
}

<div class="split">
    <section class="plane" aria-label="Everyone">
        <div class="plane-head"><h2>Everyone</h2></div>
        <div class="grid-wrap">
            <table class="dg people">
                <thead><tr><th class="first">Person</th><th>Role</th><th>On the phone system</th><th>Two-factor</th><th>Sign-in</th></tr></thead>
                <tbody>
                    @foreach (var (user, role) in _people)
                    {
                        var locked = user.LockoutEnd > DateTimeOffset.UtcNow;
                        <tr data-person="@user.Id">
                            <td class="first"><a class="row" style="gap: 10px; text-decoration: none" href="/admin/users/@user.Id"><span class="avatar">@Initials(user.UserName)</span><b style="font-weight: 500">@user.UserName</b></a></td>
                            <td><span class="tag">@role</span></td>
                            <td>@(user.TalkUserUuid is { } talk ? _talkNames.GetValueOrDefault(talk, "a Talk user no longer on the console") : "–")</td>
                            <td>@(user.TwoFactorEnabled ? "On" : "Off")</td>
                            <td>
                                @if (locked)
                                {
                                    <span class="tag warn">@(user.LockoutEnd == DateTimeOffset.MaxValue ? "Locked" : "Locked out until " + user.LockoutEnd!.Value.ToLocalTime().ToString("HH:mm"))</span>
                                }
                                else
                                {
                                    <span class="tag ok">Active</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="plane" aria-label="Add someone">
        <div class="plane-head"><h2>Add someone</h2></div>
        <form method="post" action="/admin/users" class="add-person plane-body stack" style="gap: 12px">
            <AntiforgeryToken />
            <label class="field"><span class="label">Username</span><input class="input" name="Username" required autocomplete="off" /></label>
            <label class="field"><span class="label">Role</span>
                <select class="input" name="Role">
                    <option value="@Roles.Viewer">Viewer: sees the lines they are granted</option>
                    <option value="@Roles.Manager">Manager: as a viewer, and sets up alerts for their own lines</option>
                    <option value="@Roles.Admin">Admin: everything, including people and access</option>
                    @foreach (var role in _customRoles)
                    {
                        <option value="@role">@role</option>
                    }
                </select>
            </label>
            <label class="field"><span class="label">First password</span><input class="input" name="Password" type="password" minlength="12" required autocomplete="new-password" /></label>
            <div class="row" style="gap: 8px"><button type="submit" class="btn primary sm">Add</button></div>
            <p class="hint" style="margin: 0">A new Viewer or Manager sees nothing until you grant them lines on their page.</p>
        </form>
    </section>
</div>

@code {
    // Roles admins have added, offered after the built-in ones.
    private List<string> _customRoles = [];

    [SupplyParameterFromQuery(Name = "msg")] private string? Msg { get; set; }

    private List<(AppUser User, string Role)> _people = [];
    private Dictionary<string, string> _talkNames = [];

    protected override async Task OnInitializedAsync()
    {
        _customRoles = [.. RoleStore.Roles.Select(r => r.Name!).AsEnumerable().Where(n => !Roles.BuiltIn.Contains(n)).Order()];
        foreach (var user in await Accounts.Users.Where(u => u.SiteId == Site.Id).OrderBy(u => u.UserName).ToListAsync())
        {
            _people.Add((user, (await Accounts.GetRolesAsync(user)).FirstOrDefault() ?? "(none)"));
        }

        _talkNames = await Db.Lines.AsNoTracking().Where(l => l.Kind == TalkWatch.Core.Calls.LineKind.User)
            .ToDictionaryAsync(l => l.Key, l => l.Ext is { Length: > 0 } ext ? $"{l.Name} ({ext})" : l.Name);
    }

    private static string Initials(string? name) =>
        string.Concat((name ?? "?").Split(['.', ' ', '-', '_'], StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));
}
