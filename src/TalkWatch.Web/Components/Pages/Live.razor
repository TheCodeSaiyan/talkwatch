@page "/live"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@* Now: what is happening with the phone system right now, laid out as the system it watches. Its planes are nodes on a
   flow board: calls stream in to Live calls, leave it by how they ended for Recent activity, and drop from there into
   the call log, along Data Current streams drawn by tw-board.js between the ports placed here. Calls in progress come
   from Talk's live call log, stored as they arrive, and are read again the moment one is; people and handsets come
   from the live feed. Everything goes through the viewer's access scope, in a database scope of its own for each read,
   because this page stays open. *@
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@using TalkWatch.Core.Calls
@using TalkWatch.Web.Components.Calls
@using TalkWatch.Web.Services
@using TalkWatch.Data
@inject LiveStatus Status
@inject IngestionStatus Ingestion
@inject IServiceScopeFactory Scopes
@inject TimeProvider Clock
@inject IJSRuntime JS
@inject Microsoft.Extensions.Options.IOptions<SiteOptions> Site

<PageTitle>Now · TalkWatch</PageTitle>

<header class="head">
    <div class="title">
        <h1>Now</h1>
        <div class="sub live-state @(Status.Connected ? "ok" : "warn")">
            @TimeZoneInfo.ConvertTime(Clock.GetUtcNow(), _zone).ToString("dddd d MMMM")
            ·
            @if (_demo)
            {
                <text>Demo: replaying a capture, so there is no live feed</text>
            }
            else if (Status.Connected)
            {
                <text>Connected to the console@(Status.LastEventAt is { } at ? $"; last update {at.ToLocalTime():HH:mm:ss}" : "")</text>
            }
            else
            {
                <text>Not connected to the console live feed. @Status.LastError</text>
            }
        </div>
    </div>
    <div class="tools"><a class="btn ghost sm" href="/dashboard">Today in detail</a><a class="btn sm" href="/calls">Call log</a></div>
</header>

@* The board: metric strips over the two nodes they describe, then the nodes, then the call log. Ports sit on the planes'
   edges; data-rates carries each stream's calls a minute over the last five, which set how loud it is. *@
<div class="board" data-board data-rates="@_rates" data-still="@(Status.Connected || _demo ? null : "true")">
    <div class="metrics m-a" role="group" aria-label="Calls today and in progress">
        <a class="metric" href="/calls?period=today&amp;dir=in" style="text-decoration: none; color: inherit">
            <span class="l">Calls today</span>
            <span class="v">@Roll("today", _today.Inbound.ToString(), "none")</span>
            <span class="c">Coming in, since midnight</span>
        </a>
        <div class="metric">
            <span class="l">In progress</span>
            <span class="v">@Roll("inprogress", _liveTruth.Count(c => c.Live).ToString(), null)</span>
            <span class="c">@(_liveTruth.Count(c => c.State == "ringing")) ringing · @(_liveTruth.Count(c => c.State == "menu")) in the menu</span>
        </div>
    </div>

    <div class="metrics m-b" role="group" aria-label="Answer rate and missed calls today">
        <a class="metric" href="/calls?period=today&amp;dir=in&amp;outcome=answered" style="text-decoration: none; color: inherit">
            <span class="l">Answer rate</span>
            <span class="v">@Roll("rate", _today.Inbound == 0 ? "–" : Math.Round(100.0 * _today.Answered / _today.Inbound).ToString(), "up")<small>%</small></span>
            <span class="c">@(_today.Inbound == 0 ? "No calls in yet" : $"of {_today.Inbound} calls in")</span>
        </a>
        <a class="metric" href="/calls?period=today&amp;outcome=missed" style="text-decoration: none; color: inherit">
            <span class="l">Missed</span>
            <span class="v">@Roll("missed", _today.Missed.ToString(), "down")</span>
            <span class="c">@_today.Voicemail voicemail · @_today.Menu hung up in the menu</span>
        </a>
    </div>

    <section class="plane node node-live" aria-label="Live calls">
        <i class="port" data-port="inlet" title="Calls coming in"></i>
        <i class="port" data-port="answered" title="Answered"></i>
        <i class="port" data-port="voicemail" title="Voicemail"></i>
        <i class="port" data-port="missed" title="Missed"></i>
        <div class="plane-head">
            <i class="ring" data-tone="live" aria-hidden="true"></i>
            <div class="row" style="gap: 10px"><h2>Live calls</h2><span class="mono muted" style="font-size: 12px">@_liveTruth.Count(c => c.Live) in progress</span></div>
            @Waiting("live")
            <div class="end"><span class="cap" data-c="derived">Live from Talk's call log</span></div>
            <canvas class="edge" data-edge="live" aria-hidden="true"></canvas>
        </div>
        <div class="calls-live" role="list" aria-live="polite" aria-relevant="additions" data-live-calls data-hold="live">
            @if (_live.Count == 0)
            {
                <div class="empty" data-kind="none" style="padding: 24px 16px">
                    <b>No calls right now</b>
                    <p class="why">@(_demo ? "The demo replays a capture, so it has nothing live to show. A real console's calls appear here as they ring." : "New calls appear here the moment Talk reports them, with their route as it happens.")</p>
                </div>
            }
            @foreach (var c in _live)
            {
                <LiveCallRow Call="c" Now="Clock.GetUtcNow()" @key="c.Call.TalkUuid" />
            }
        </div>
    </section>

    <div class="board-legend" aria-hidden="true">
        <span data-stream="answered">Answered</span><span data-stream="voicemail">Voicemail</span><span data-stream="missed">Missed</span>
    </div>

    <section class="plane node node-recent" aria-label="Recent activity">
        <i class="port" data-port="in" title="Calls that have ended"></i>
        <i class="port" data-port="archive" title="Into the call log"></i>
        <div class="plane-head">
            <i class="ring" data-tone="ok" aria-hidden="true"></i>
            <h2>Recent activity</h2>
            @Waiting("recent")
            <div class="end"><a class="btn ghost sm" href="/calls">Call log</a></div>
            <canvas class="edge" data-edge="recent" aria-hidden="true"></canvas>
        </div>
        <div class="stream" role="feed" data-hold="recent">
            @if (_recent.Count == 0)
            {
                <p class="empty" style="padding: 16px">No calls today yet.</p>
            }
            @foreach (var r in _recent)
            {
                <a class="ev" href="/calls/@r.TalkUuid" data-inspect="@r.TalkUuid" style="text-decoration: none; color: inherit" data-key="@r.TalkUuid" data-stream="@r.Stream" @key="r.TalkUuid">
                    <span class="t">@TimeZoneInfo.ConvertTime(r.Time, _zone).ToString("HH:mm")</span>
                    <span class="g oc" data-o="@CallMarks.Key(r.Outcome)"><Icon Name="@CallMarks.Icon(r.Outcome)" /></span>
                    <span class="b"><div>@r.Lead<span data-grow>@r.Party</span>@r.Tail</div><div class="s">@r.Sub</div></span>
                </a>
            }
        </div>
    </section>

    <section class="plane node node-log" aria-label="Call log">
        <i class="port" data-port="log" title="From Recent activity"></i>
        <div class="plane-head">
            <i class="ring" data-tone="hist" aria-hidden="true"></i>
            <h2>Call log</h2>
            <span class="muted" style="font-size: 12px">The latest calls, in and out</span>
            @Waiting("log")
            <div class="end"><a class="btn ghost sm" href="/calls">Open the call log</a></div>
            <canvas class="edge" data-edge="log" aria-hidden="true"></canvas>
        </div>
        <div class="log" role="list" data-hold="log">
            @if (_log.Count == 0)
            {
                <p class="empty" style="padding: 16px">No calls in the log yet.</p>
            }
            @foreach (var l in _log)
            {
                <a class="lg" role="listitem" href="/calls/@l.TalkUuid" data-inspect="@l.TalkUuid" style="text-decoration: none; color: inherit" data-key="@l.TalkUuid" @key="l.TalkUuid">
                    <span class="t">@TimeZoneInfo.ConvertTime(l.Time, _zone).ToString("HH:mm")</span>
                    <span class="dir" data-d="@CallMarks.DirectionKey(l.Direction)" title="@CallMarks.Direction(l.Direction)"><Icon Name="@CallMarks.DirectionKey(l.Direction)" /><span class="sr">@CallMarks.Direction(l.Direction)</span></span>
                    <span class="who"><b data-grow>@l.Who</b><span class="n">@l.Number</span></span>
                    <span class="line hide-sm">@l.Line</span>
                    <span class="oc" data-o="@CallMarks.Key(l.Outcome)"><Icon Name="@CallMarks.Icon(l.Outcome)" />@CallMarks.Words(l.Outcome)</span>
                    <span class="num">@CallMarks.Duration(TimeSpan.FromSeconds(l.Seconds))</span>
                </a>
            }
        </div>
    </section>
</div>

<div class="split">
    @* Everyone sees only the people, and their handsets, that their grants cover; admins see the whole site. *@
    <section class="plane" aria-label="People">
        <div class="plane-head"><h2>People</h2><span class="mono muted" style="font-size: 12px">@_users.Count(u => u.OnCall) of @_users.Count on calls</span><div class="end"><span class="cap" data-c="talk">Talk's live feed</span></div></div>
        @if (_users.Count == 0)
        {
            <p class="empty" style="padding: 16px">No one to show. Nobody's line has been granted to you, or the directory has not loaded yet.</p>
        }
        else
        {
            <div class="pfield live-users" style="border: 0; border-radius: 0">
                @foreach (var user in _users)
                {
                    <div class="pcell @(user.OnCall ? "on-call" : "")" data-user="@user.Uuid" data-p="@Presence(user)" @key="user.Uuid">
                        <span class="avatar">@Initials(user.Name)</span>
                        <span class="who"><b>@user.Name</b><span class="x">@(user.Ext is null ? "" : "Ext " + user.Ext)</span></span>
                        <span class="row" style="gap: 6px" title="@PresenceWords(user)"><span class="pr" data-p="@Presence(user)" aria-hidden="true"></span><span class="state">@PresenceWords(user)</span></span>
                    </div>
                }
            </div>
        }
    </section>

    <section class="plane" aria-label="Handsets">
        <div class="plane-head"><h2>Handsets</h2><span class="muted" style="font-size: 12px">@_devices.Count(d => d.Status == "online") of @_devices.Count online</span></div>
        @if (_devices.Count == 0)
        {
            <p class="empty" style="padding: 16px">No handsets to show.</p>
        }
        else
        {
            <ul class="live-devices" style="list-style: none; margin: 0; padding: 0">
                @foreach (var device in _devices)
                {
                    <li data-device="@device.Mac" class="row @(device.Status == "online" ? "online" : "offline")" style="padding: 8px 16px; border-bottom: 1px solid var(--line); gap: 10px" @key="device.Mac">
                        <span class="pr" data-p="@(device.Status == "online" ? "available" : "offline")" aria-hidden="true"></span>
                        <span class="who" style="flex: 1"><b>@(device.Name ?? device.Model)</b><span class="n">@(device.Ext is null ? "" : "Ext " + device.Ext) @device.Model</span></span>
                        <span class="muted" style="font-size: 12px">@(device.Status == "online" ? (device.Registered == false ? "Online, not registered" : "Online") : "Offline" + (device.LastSeen is { } seen ? " since " + seen.ToLocalTime().ToString("HH:mm") : ""))</span>
                        @if (device.UpdateAvailable == true)
                        {
                            <span class="tag warn">Update available</span>
                        }
                    </li>
                }
            </ul>
        }
    </section>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationState { get; set; }

    // The sentence in three parts, so the caller's name can grow from it into the Context Inspector.
    private sealed record Recent(string TalkUuid, DateTimeOffset Time, CallOutcome Outcome, string Lead, string Party, string Tail, string Sub, string Stream);

    private sealed record Logged(string TalkUuid, DateTimeOffset Time, string Direction, CallOutcome Outcome, string Who, string Number, string Line, int Seconds);

    private sealed record Today(int Inbound, int Answered, int Missed, int Voicemail, int Menu);

    private System.Security.Claims.ClaimsPrincipal _user = new();
    private bool _admin;
    private bool _demo;
    private TimeZoneInfo _zone = TimeZoneInfo.Utc;
    private HashSet<string> _allowedUsers = [];
    private IReadOnlyList<LiveUser> _users = [];
    private IReadOnlyList<LiveDevice> _devices = [];

    // What is true now, and what each list shows: the same, unless someone is pointing at the list (see Hold).
    private List<LiveCall> _liveTruth = [];
    private List<Recent> _recentTruth = [];
    private List<Logged> _logTruth = [];
    private List<LiveCall> _live = [];
    private List<Recent> _recent = [];
    private List<Logged> _log = [];
    private readonly HashSet<string> _holding = new(StringComparer.Ordinal);
    private readonly Dictionary<string, int> _waiting = new(StringComparer.Ordinal);

    private Today _today = new(0, 0, 0, 0, 0);
    private string _rates = "{}";
    private CancellationTokenSource? _pending;
    private Timer? _timer;
    private Timer? _expire;
    private DotNetObjectReference<Live>? _self;

    [Inject] private Microsoft.Extensions.Options.IOptions<DemoOptions> Demo { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _user = (await AuthenticationState!).User;
        _admin = _user.Can(Permission.AllCalls);
        _demo = Demo.Value.Enabled;
        _zone = TimeZoneInfo.FindSystemTimeZoneById(Site.Value.TimeZone);

        // A finished call leaves the board when its moment is up, read again at that time rather than on the next poll.
        _expire = new Timer(_ => OnCallsStored(), null, Timeout.Infinite, Timeout.Infinite);
        await ReadCallsAsync();
        Refresh();
        Status.Changed += OnChanged;
        Ingestion.CallsStored += OnCallsStored;
        // The streams' rates are over the last five minutes, so they fall away even when nothing new arrives.
        _timer = new Timer(_ => OnCallsStored(), null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    // The board's script tells the page when someone is pointing at one of its lists; only then does it hold still.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _self = DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("TW.board.connect", _self);
        }
        catch (JSException)
        {
            // Without the script the lists never hold, which is how the page behaves anyway.
        }
        catch (JSDisconnectedException)
        {
        }
    }

    /// <summary>Calls in progress and those that ended a moment ago, what has ended since, today's figures and the streams' rates.</summary>
    private async Task ReadCallsAsync()
    {
        using var scope = Scopes.CreateScope();
        scope.ServiceProvider.GetRequiredService<AccessScopeHolder>().UsePrincipal(_user);
        var db = scope.ServiceProvider.GetRequiredService<TalkWatchDbContext>();

        // A grant on a user covers that person and the handsets assigned to them. Grants are read through the access
        // scope, so this is only ever this person's own.
        if (!_admin)
        {
            _allowedUsers = (await db.Grants.AsNoTracking().Where(g => g.Kind == LineKind.User).Select(g => g.Key).ToListAsync()).ToHashSet(StringComparer.Ordinal);
        }

        var now = Clock.GetUtcNow();
        var today = new DateTimeOffset(TimeZoneInfo.ConvertTimeToUtc(TimeZoneInfo.ConvertTime(now, _zone).Date, _zone), TimeSpan.Zero);

        // In progress for at most a few hours: a call whose hang-up never arrived is settled by the poller a day later.
        var current = await db.Calls.AsNoTracking().Current(now).OrderBy(c => c.Time).Take(40).ToListAsync();
        // More than each list shows: the calls still on the board are taken out of them below.
        var recent = await db.Calls.AsNoTracking().Where(c => c.Time >= today && c.Outcome != CallOutcome.InProgress)
            .OrderByDescending(c => c.Time).Take(60).ToListAsync();
        var logged = await db.Calls.AsNoTracking().Where(c => c.Outcome != CallOutcome.InProgress)
            .OrderByDescending(c => c.Time).Take(60).ToListAsync();

        var all = current.Concat(recent).Concat(logged).DistinctBy(c => c.Id).ToList();
        var names = await ChronicleLoader.NamesAsync(db, all.SelectMany(c => new[] { c.FromE164, c.ToE164, c.AnsweredByE164 }));
        var chronicles = await ChronicleLoader.ForAsync(db, all, names);

        string Party(CallRow c) => c.Direction == "out" ? names.Number(c.ToE164 ?? "") ?? c.ToRaw ?? "Someone" : c.CallerName ?? names.Number(c.FromE164 ?? "") ?? c.FromRaw ?? "Withheld number";
        string Line(CallRow c) => names.Number(c.ToE164 ?? "") ?? c.ToRaw ?? "";

        // On the board a finished call stays only a moment, resolved, then rides into Recent activity. Until it has, it
        // is in neither Recent activity nor the call log, and a call still going is in neither at all.
        var calls = current.Select(c => LiveCalls.Of(c, chronicles[c.Id], names)).ToList();
        _liveTruth = [.. calls.Where(c => c.Live || c.Call.UpdatedAt >= now - LiveCalls.Linger)];
        var onBoard = calls.Where(c => c.Live || c.Call.UpdatedAt >= now - LiveCalls.Linger).Select(c => c.Call.Id).ToHashSet();
        var going = calls.Where(c => c.Live).Select(c => c.Call.Id).ToHashSet();

        (string Lead, string Tail) Words(CallRow c) => c.Outcome switch
        {
            CallOutcome.Answered => ($"{chronicles[c.Id].Steps.FirstOrDefault(s => s.Kind == StepKind.Answered)?.Subject ?? "Someone"} answered ", ""),
            CallOutcome.Missed => ("Missed call from ", ""),
            CallOutcome.Voicemail => ("Voicemail from ", ""),
            CallOutcome.HungUpAtSwitchboard => ("", " hung up in the menu"),
            CallOutcome.Outbound => ("Call to ", ""),
            _ => ("Call with ", ""),
        };

        _recentTruth = [.. recent.Where(c => !onBoard.Contains(c.Id) && !going.Contains(c.Id)).Take(12).Select(c => new Recent(c.TalkUuid, c.Time, c.Outcome, Words(c).Lead, Party(c), Words(c).Tail,
            (Line(c) is { Length: > 0 } l && c.Direction == "in" ? l + " · " : "") + CallMarks.Duration(TimeSpan.FromSeconds(c.DurationSeconds)), LiveCalls.Stream(c.Outcome)))];

        _logTruth = [.. logged.Where(c => !onBoard.Contains(c.Id) && !going.Contains(c.Id)).Take(8).Select(c => new Logged(c.TalkUuid, c.Time, c.Direction, c.Outcome, Party(c),
            (c.Direction == "out" ? c.ToRaw : c.FromRaw) is { } n && n != Party(c) ? n : "", c.Direction == "in" ? Line(c) : "", c.DurationSeconds))];

        var todayCounts = await db.Calls.AsNoTracking().Where(c => c.Direction == "in" && c.Time >= today)
            .GroupBy(c => c.Outcome).Select(g => new { g.Key, Count = g.Count() }).ToListAsync();
        int Count(CallOutcome o) => todayCounts.Where(x => x.Key == o).Sum(x => x.Count);
        _today = new Today(todayCounts.Sum(x => x.Count), Count(CallOutcome.Answered), CallOutcomes.MissedKinds.Sum(Count), CallOutcomes.VoicemailKinds.Sum(Count), Count(CallOutcome.HungUpAtSwitchboard));

        // Each stream's loudness: calls a minute over the last five. A call ended when Talk logged its hang-up, not when
        // TalkWatch last stored it: a poll stores old calls again, and they did not all just end.
        var five = now - TimeSpan.FromMinutes(5);
        var started = await db.Calls.AsNoTracking().CountAsync(c => c.Direction == "in" && c.Time >= five);
        var finished = (await db.Calls.AsNoTracking().Where(c => c.Outcome != CallOutcome.InProgress && c.Events.Any(e => e.Event == "call_hangup" && e.Time >= five))
            .Select(c => new { c.Id, c.Outcome }).Take(500).ToListAsync()).Where(c => !going.Contains(c.Id)).ToList();
        double PerMinute(int n) => Math.Round(n / 5.0, 2);
        _rates = JsonSerializer.Serialize(new
        {
            inlet = PerMinute(started),
            answered = PerMinute(finished.Count(c => LiveCalls.Stream(c.Outcome) == "answered")),
            voicemail = PerMinute(finished.Count(c => LiveCalls.Stream(c.Outcome) == "voicemail")),
            missed = PerMinute(finished.Count(c => LiveCalls.Stream(c.Outcome) == "missed")),
            archive = PerMinute(finished.Count),
            live = going.Count,
        });

        Show();

        // Read again when the next finished call's moment on the board is up.
        var next = _liveTruth.Where(c => !c.Live).Select(c => c.Call.UpdatedAt + LiveCalls.Linger).DefaultIfEmpty(DateTimeOffset.MaxValue).Min();
        if (next != DateTimeOffset.MaxValue)
        {
            _expire?.Change(TimeSpan.FromMilliseconds(Math.Max(0, (next - now).TotalMilliseconds) + 100), Timeout.InfiniteTimeSpan);
        }
    }

    /// <summary>What each list shows: the truth, unless it is held, when it keeps its rows and counts what is waiting.</summary>
    private void Show()
    {
        _live = Pick("live", _live, _liveTruth, c => c.Call.TalkUuid);
        _recent = Pick("recent", _recent, _recentTruth, r => r.TalkUuid);
        _log = Pick("log", _log, _logTruth, l => l.TalkUuid);
    }

    private List<T> Pick<T>(string list, List<T> shown, List<T> truth, Func<T, string> key)
    {
        if (!_holding.Contains(list))
        {
            _waiting[list] = 0;
            return truth;
        }

        var (kept, waiting) = HeldList.Hold(shown, truth, key);
        _waiting[list] = waiting;
        return kept;
    }

    /// <summary>Called by the board's script: someone is pointing at a list, or has left it half a second ago.</summary>
    [JSInvokable]
    public Task Hold(string list, bool on) => InvokeAsync(() =>
    {
        if (list is not ("live" or "recent" or "log") || !(on ? _holding.Add(list) : _holding.Remove(list)))
        {
            return;
        }

        Show();
        StateHasChanged();
    });

    // "2 waiting · Show" applies what is held at once; the list goes on holding while the pointer stays.
    private void Release(string list)
    {
        switch (list)
        {
            case "live": _live = _liveTruth; break;
            case "recent": _recent = _recentTruth; break;
            case "log": _log = _logTruth; break;
        }

        _waiting[list] = 0;
    }

    private RenderFragment Waiting(string list) => @<text>@if (_waiting.GetValueOrDefault(list) is > 0 and var n)
        {
            <button type="button" class="held" @onclick="() => Release(list)">@n waiting · Show</button>
        }</text>;

    // A count the board's script rolls like an odometer: the figure itself stays in the page for screen readers and for
    // a browser without the script. "better" says which way is good, for the delta chip; none has no right way, and no
    // value means no chip at all.
    private static RenderFragment Roll(string key, string value, string? better) =>
        @<span class="roll" data-roll="@key" data-better="@better"><span class="rv">@value</span></span>;

    private void Refresh()
    {
        var (users, devices) = Status.Snapshot();
        _users = _admin ? users : [.. users.Where(u => _allowedUsers.Contains(u.Uuid))];
        _devices = _admin ? devices : [.. devices.Where(d => d.UserUuid is { } owner && _allowedUsers.Contains(owner))];
    }

    private void OnChanged() => InvokeAsync(() =>
    {
        Refresh();
        StateHasChanged();
    });

    // Calls arrive in bursts (one message per step); a quarter-second gathers a burst into one read.
    private void OnCallsStored()
    {
        _pending?.Cancel();
        _pending = new CancellationTokenSource();
        var token = _pending.Token;
        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(250, token);
                await ReadCallsAsync();
                StateHasChanged();
            }
            catch (TaskCanceledException)
            {
            }
        });
    }

    private static string Presence(LiveUser u) => u.OnCall ? "busy" : u.Presence?.ToLowerInvariant() switch
    {
        "dnd" or "do_not_disturb" or "busy" => "dnd",
        "offline" or "unavailable" => "offline",
        _ => "available",
    };

    private static string PresenceWords(LiveUser u) => Presence(u) switch
    {
        "busy" => "On a call",
        "dnd" => "Do not disturb",
        "offline" => "Offline",
        _ => u.Presence is { Length: > 0 } p ? char.ToUpperInvariant(p[0]) + p[1..].Replace('_', ' ') : "Available",
    };

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch { 0 => "?", 1 => parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant(), _ => string.Concat(parts[0][0], parts[^1][0]).ToUpperInvariant() };
    }

    public void Dispose()
    {
        Status.Changed -= OnChanged;
        Ingestion.CallsStored -= OnCallsStored;
        _timer?.Dispose();
        _expire?.Dispose();
        _pending?.Cancel();
        _pending?.Dispose();
        _self?.Dispose();
    }
}
