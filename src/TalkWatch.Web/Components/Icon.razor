@* TalkWatch's own icons, from the design system: 1.6px stroke on a 16px grid, round joins, currentColor. Decorative
   by default; pass Label when the icon is the only thing saying what something is. *@
<svg class="ico @Size" viewBox="0 0 16 16" aria-hidden="@(Label is null ? "true" : null)" role="@(Label is null ? null : "img")" aria-label="@Label"><path d="@Path(Name)"></path></svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    /// <summary>"s" for 14px in dense rows, "l" for 20px; empty for the 16px default.</summary>
    [Parameter] public string Size { get; set; } = "";

    [Parameter] public string? Label { get; set; }

    private static string Path(string name) => Paths.TryGetValue(name, out var d) ? d : Paths["info"];

