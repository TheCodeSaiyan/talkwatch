# Copy to .env beside compose.yaml and fill in. .env holds passwords, so git ignores it: never commit it.

# The image to run. Leave unset for the published image.
# TALKWATCH_IMAGE=ghcr.io/thecodesaiyan/talkwatch:latest
# TALKWATCH_PORT=8080

# PostgreSQL's password. Any long random value; it never leaves the two containers.
# It is placed in a connection string, so avoid ';' and '='.
DB_PASSWORD=

SITE_NAME=TalkWatch
# ISO 3166 region for numbers written without a country code.
SITE_REGION=GB

# The console's LAN address. Polling stays off until this is set.
TALK_CONSOLE_URL=https://192.168.1.1
# A console user with read-only access to Talk. Sign-in uses the username, not an e-mail address.
TALK_USERNAME=talkwatch
TALK_PASSWORD=
# The console's certificate fingerprint. Get it with the capture tool's 'cert' command, and check it against the
# certificate your browser shows for the console before trusting it.
TALK_CERTIFICATE_SHA256=
# TALK_POLL_SECONDS=60

# The first admin account, created on the first start only. At least 12 characters. Remove the password afterwards.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
