# Copy to .env beside compose.yaml and fill in. Passwords don't go here: they are files in ./secrets (see the install
# guide), which git ignores, as it does .env.

# The image to run. Leave unset for the published image.
# TALKWATCH_IMAGE=ghcr.io/thecodesaiyan/talkwatch:latest
# TALKWATCH_PORT=8080
# Which of the host's addresses the port is published on: all of them, for a first run on the LAN. With the reverse
# proxy on this same host, 127.0.0.1, so nothing but the proxy reaches TalkWatch's plain HTTP.
# TALKWATCH_BIND=0.0.0.0

SITE_NAME=TalkWatch
# ISO 3166 region for numbers written without a country code.
SITE_REGION=GB
# The https address people reach TalkWatch at, behind your reverse proxy. Alerts link to it, and with it set the
# sign-in cookie is sent over https alone.
# SITE_PUBLIC_URL=https://talkwatch.example

# The console's LAN address, https only. Polling stays off until this is set.
TALK_CONSOLE_URL=https://192.168.1.1
# A console user with read-only access to Talk. Sign-in uses the username, not an e-mail address. Its password is
# secrets/talk_password.
TALK_USERNAME=talkwatch
# The console's certificate fingerprint. Get it with the capture tool's 'cert' command, and check it against the
# certificate your browser shows for the console before trusting it.
TALK_CERTIFICATE_SHA256=
# TALK_POLL_SECONDS=60

# The first admin account, created on the first start only. Its password, at least 12 characters, is
# secrets/admin_password.
BOOTSTRAP_ADMIN_USERNAME=admin
